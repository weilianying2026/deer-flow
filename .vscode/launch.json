{
  // DeerFlow 调试流程说明：
  // 1) 先在项目根目录运行 make dev-pro（启动 Frontend + Nginx）。
  // 2) 按 F5 启动本文件第一个配置 DeerFlow: Debug Gateway (F5)。
  // 3) 在后端 router 打断点后，从页面 http://localhost:2026 发起请求即可命中。
  // 4) 如果 Gateway 已由其它方式启动，使用 DeerFlow: Attach Running Gateway 附加调试。
  // 说明：页面入口固定是 http://localhost:2026；8001 主要用于 Gateway API 调试。
  "version": "0.2.0",
  "configurations": [
    {
      // 默认 F5 配置：直接启动可断点的 Gateway 进程。
      "name": "DeerFlow: Debug Gateway (F5)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/backend",
      "args": [
        "app.gateway.app:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8001"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // 备用配置：附加到已在运行中的 Gateway Python 进程。
      "name": "DeerFlow: Attach Running Gateway",
      "type": "debugpy",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "justMyCode": false
    }
  ]
}
